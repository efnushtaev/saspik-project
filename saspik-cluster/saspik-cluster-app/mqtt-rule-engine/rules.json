{
  "_meta": {
    "description": "Правила климат-контроля для MQTT Rule Engine Worker",
    "data_sources": {
      "sensors/dht22": "{ temperature: number, humidity: number, timestamp: ISO8601 }",
      "sensors/float-1": "{ floatSensor: number, timestamp: ISO8601 }"
    },
    "commands": {
      "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay1": "свет (1=ON, 0=OFF)",
      "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay2": "увлажнитель (1=ON, 0=OFF)",
      "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay3": "вентилятор (1=ON, 0=OFF)",
      "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay4": "вода (1=ON, 0=OFF)"
    },
    "temperature_zones": {
      "emergency_high":  "temp > T_MAX → fan=ON, humidifier=ON",
      "recovery_high":   "T_RECOVERY < temp ≤ T_MAX → выход из аварии, humidifier_off заблокирован",
      "normal":          "T_MIN ≤ temp ≤ T_RECOVERY → полный гистерезис",
      "emergency_low":   "temp < T_MIN → fan=OFF"
    },
    "@todo": "Продублировать правила для каждого unitId — engine не поддерживает подстановку из wildcard-топика"
  },
  "rules": [
    {
      "id": "temp_emergency_high",
      "trigger": { "topic": "sensors/dht22", "qos": 0 },
      "when": {
        "or": [
          {
            "and": [
              { "not": { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } } },
              { "jsonpath": "$.temperature > ${CLIMATE_T_MAX}" }
            ]
          },
          {
            "and": [
              { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } },
              { "jsonpath": "$.temperature > ${CLIMATE_NIGHT_T_MAX}" }
            ]
          }
        ]
      },
      "then": [
        { "action": "publish", "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay3", "payload": "\"1\"", "qos": 1 } },
        { "action": "publish", "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay2", "payload": "\"1\"", "qos": 1 } }
      ]
    },
    {
      "id": "temp_emergency_low",
      "trigger": { "topic": "sensors/dht22", "qos": 0 },
      "when": {
        "or": [
          {
            "and": [
              { "not": { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } } },
              { "jsonpath": "$.temperature < ${CLIMATE_T_MIN}" }
            ]
          },
          {
            "and": [
              { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } },
              { "jsonpath": "$.temperature < ${CLIMATE_NIGHT_T_MIN}" }
            ]
          }
        ]
      },
      "then": [
        { "action": "publish", "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay3", "payload": "\"0\"", "qos": 1 } }
      ]
    },
    {
      "id": "fan_on",
      "trigger": { "topic": "sensors/dht22", "qos": 0 },
      "when": {
        "or": [
          {
            "and": [
              { "not": { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } } },
              { "jsonpath": "$.temperature > ${expr:CLIMATE_T_SET + CLIMATE_T_HYST / 2}" },
              { "jsonpath": "$.temperature <= ${CLIMATE_T_MAX}" }
            ]
          },
          {
            "and": [
              { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } },
              { "jsonpath": "$.temperature > ${expr:CLIMATE_NIGHT_T_SET + CLIMATE_NIGHT_T_HYST / 2}" },
              { "jsonpath": "$.temperature <= ${CLIMATE_NIGHT_T_MAX}" }
            ]
          }
        ]
      },
      "then": [
        { "action": "publish", "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay3", "payload": "\"1\"", "qos": 1 } }
      ]
    },
    {
      "id": "fan_off",
      "trigger": { "topic": "sensors/dht22", "qos": 0 },
      "when": {
        "or": [
          {
            "and": [
              { "not": { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } } },
              { "jsonpath": "$.temperature < ${expr:CLIMATE_T_SET - CLIMATE_T_HYST / 2}" },
              { "jsonpath": "$.temperature >= ${CLIMATE_T_MIN}" }
            ]
          },
          {
            "and": [
              { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } },
              { "jsonpath": "$.temperature < ${expr:CLIMATE_NIGHT_T_SET - CLIMATE_NIGHT_T_HYST / 2}" },
              { "jsonpath": "$.temperature >= ${CLIMATE_NIGHT_T_MIN}" }
            ]
          }
        ]
      },
      "then": [
        { "action": "publish", "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay3", "payload": "\"0\"", "qos": 1 } }
      ]
    },
    {
      "id": "humidifier_on",
      "trigger": { "topic": "sensors/dht22", "qos": 0 },
      "when": {
        "or": [
          {
            "and": [
              { "not": { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } } },
              { "jsonpath": "$.humidity < ${expr:CLIMATE_RH_SET - CLIMATE_RH_HYST / 2}" }
            ]
          },
          {
            "and": [
              { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } },
              { "jsonpath": "$.humidity < ${expr:CLIMATE_NIGHT_RH_SET - CLIMATE_NIGHT_RH_HYST / 2}" }
            ]
          }
        ]
      },
      "then": [
        { "action": "publish", "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay2", "payload": "\"1\"", "qos": 1 } }
      ]
    },
    {
      "id": "humidifier_off",
      "trigger": { "topic": "sensors/dht22", "qos": 0 },
      "when": {
        "or": [
          {
            "and": [
              { "not": { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } } },
              { "jsonpath": "$.humidity > ${expr:CLIMATE_RH_SET + CLIMATE_RH_HYST / 2}" },
              { "jsonpath": "$.temperature <= ${CLIMATE_T_RECOVERY}" }
            ]
          },
          {
            "and": [
              { "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" } },
              { "jsonpath": "$.humidity > ${expr:CLIMATE_NIGHT_RH_SET + CLIMATE_NIGHT_RH_HYST / 2}" },
              { "jsonpath": "$.temperature <= ${CLIMATE_NIGHT_T_RECOVERY}" }
            ]
          }
        ]
      },
      "then": [
        { "action": "publish", "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay2", "payload": "\"0\"", "qos": 1 } }
      ]
    },
    {
      "id": "light_on",
      "trigger": { "topic": "sensors/dht22", "qos": 0 },
      "when": {
        "not": {
          "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" }
        }
      },
      "then": [
        { "action": "publish", "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay1", "payload": "\"1\"", "qos": 1 } }
      ]
    },
    {
      "id": "light_off",
      "trigger": { "topic": "sensors/dht22", "qos": 0 },
      "when": {
        "timeBetween": { "start": ${NIGHT_START_HOUR}, "end": ${NIGHT_END_HOUR}, "field": "$.timestamp" }
      },
      "then": [
        { "action": "publish", "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay1", "payload": "\"0\"", "qos": 1 } }
      ]
    },
    {
      "id": "water_on",
      "trigger": { "topic": "sensors/float-1", "qos": 0 },
      "when": {
        "jsonpath": "$.floatSensor == 0"
      },
      "then": [
        {
          "action": "publish",
          "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay4", "payload": "\"1\"", "qos": 1 }
        },
        {
          "action": "timeout",
          "params": {
            "delay": ${WATER_TIMEOUT_MS},
            "then": [
              {
                "action": "publish",
                "params": { "topic": "units/${CLIMATE_CONTROL_UNIT_ID}/commands/a_relay4", "payload": "\"0\"", "qos": 1 }
              }
            ]
          }
        }
      ]
    }
  ]
}
