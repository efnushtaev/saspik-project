{
  "rules": [
    {
      "id": "humidity_high",
      "trigger": {
        "topic": "sensor/${CLIMATE_CONTROL_UNIT_ID}/dht22",
        "qos": 0
      },
      "when": {
        "jsonpath": "$.humidity >= 70"
      },
      "then": [
        {
          "action": "publish",
          "params": {
            "topic": "led/control",
            "payload": "ON",
            "qos": 1
          }
        }
      ]
    },
    {
      "id": "humidity_low",
      "trigger": {
        "topic": "sensor/${CLIMATE_CONTROL_UNIT_ID}/dht22",
        "qos": 0
      },
      "when": {
        "jsonpath": "$.humidity < 70"
      },
      "then": [
        {
          "action": "publish",
          "params": {
            "topic": "led/control",
            "payload": "OFF",
            "qos": 1
          }
        }
      ]
    }
  ]
}
